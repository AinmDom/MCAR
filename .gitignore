/external/SUpDEq/*

# Regenerable training, reconstruction, and reproduction outputs.
/artifacts/*
!/artifacts/README.md

# Large HRTF datasets and processed residual tensors. Keep only the
# acquisition/provenance README; every dataset payload remains local.
/data/HRTF/*
!/data/HRTF/README.md
/data/processed/*
!/data/processed/README.md
!/data/processed/hutubs_residual_v1_n03/
/data/processed/hutubs_residual_v1_n03/*
!/data/processed/hutubs_residual_v1_n03/training_statistics.json

