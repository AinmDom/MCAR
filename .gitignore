# Local IDE project metadata.
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Python environments, bytecode, test caches, and local tooling state.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# MATLAB generated files and build products.
*.asv
*.m~
slprj/
codegen/
*.mexw32
*.mexw64
*.mexa64
*.mexmaci64

# Large datasets, intermediate arrays, and model checkpoints.
# Keep lightweight provenance, metrics, and reports as README/CSV/JSON files.
*.sofa
*.mat
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.ckpt

# Runtime logs and temporary process files.
*.log
*.pid
*.tmp
*.temp

# Third-party dependency kept locally; do not version its sources or data.
SUpDEq-master/*
!SUpDEq-master/README.project.md

# Reproducible outputs from scripts/run_mca_demo_export.m.
/figures/mca_demo_ku100_ns3_nd44/*
!/figures/mca_demo_ku100_ns3_nd44/README.md

# Large, generated experiment features and intermediate results.
/outputs/*
!/outputs/README.md

# Keep reproducible MATLAB entry points, but ignore large checkpoints and
# generated results under the MCA-paper reproduction workspace. Keep only
# compact cross-subject tables and publication-ready PNG summaries.
/reproduce/*
!/reproduce/*.m
!/reproduce/hutubs_mca_batch/
/reproduce/hutubs_mca_batch/*
!/reproduce/hutubs_mca_batch/aggregate/
/reproduce/hutubs_mca_batch/aggregate/*
!/reproduce/hutubs_mca_batch/aggregate/aggregation_report.txt
!/reproduce/hutubs_mca_batch/aggregate/aggregate_erb_by_order_paper_unweighted.csv
!/reproduce/hutubs_mca_batch/aggregate/aggregate_binaural_by_order.csv
!/reproduce/hutubs_mca_batch/aggregate/aggregate_frequency_by_order_quadrature_weighted.csv
!/reproduce/hutubs_mca_batch/aggregate/mca_improvement_by_order.csv
!/reproduce/hutubs_mca_batch/aggregate/key_findings.csv
!/reproduce/hutubs_mca_batch/aggregate/fig05_region_magnitude_error.png
!/reproduce/hutubs_mca_batch/aggregate/full_sphere_magnitude_error.png
!/reproduce/hutubs_mca_batch/aggregate/binaural_error_by_order.png
!/reproduce/hutubs_mca_batch/aggregate/frequency_error_n3_n6.png

# Large HRTF datasets kept locally; track only data/HRTF/README.md.
/data/HRTF/axd/
/data/HRTF/hutubs/
