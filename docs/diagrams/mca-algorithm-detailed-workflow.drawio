<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-07-15T13:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="mca-detailed" name="MCA 算法详细流程">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="MCA（Magnitude-Corrected and Time-Aligned）算法详细流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="900" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="params" value="Demo 参数：ppMethod = SUpDEq；ipMethod = SH；mc = Inf；headRadius = 0.0875 m&#xa;默认：limitMC = true；mcMinPhase = true；limFade = fadeDown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="550" y="85" width="800" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="输入&#xa;稀疏双耳 HRTF/HRIR + 稀疏采样网格&#xa;目标密集网格 ipSamplingGrid" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="765" y="190" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="split" value="建立两条并行路径" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="320" width="280" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="laneA" value="路径 A：时间对齐的 HRTF 插值" style="swimlane;html=1;rounded=1;horizontal=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="830" height="435" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="SUpDEq 预处理&#xa;用对应刚性球传递函数 STF 对稀疏 HRTF 方向均衡&#xa;削弱方向相关的宽带时延与谱变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="laneA">
          <mxGeometry x="35" y="65" width="230" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="空间插值&#xa;均衡后的 HRTF → 球谐域&#xa;在目标方向执行 SH 重建" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="laneA">
          <mxGeometry x="300" y="65" width="215" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="SUpDEq 反处理&#xa;目标方向 HRTF × 对应 STF&#xa;恢复方向相关时间与频谱成分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="laneA">
          <mxGeometry x="550" y="65" width="230" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="得到未做幅度校正的稠密 HRTF&#xa;ĤnoMC,L / ĤnoMC,R&#xa;保存为 HRTF_L/R_ip_noMC" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="laneA">
          <mxGeometry x="290" y="235" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="当前插值结果的听觉幅度&#xa;ĤnoMC → IFFT → HRIR&#xa;→ ERB 滤波器组分析&#xa;得到 cHRIR,ip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="laneA">
          <mxGeometry x="585" y="230" width="205" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="laneB" value="路径 B：听觉平滑幅度参考" style="swimlane;html=1;rounded=1;horizontal=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="470" width="830" height="435" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="稀疏 HRIR 的听觉分析&#xa;左右耳分别通过 ERB 滤波器组&#xa;频率范围：50 Hz ～ fs/2&#xa;得到 cl、cr（dB）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="laneB">
          <mxGeometry x="35" y="65" width="230" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="对 ERB 频带幅度做空间插值&#xa;使用与主路径相同的 ipMethod&#xa;Demo 中为 SH 插值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="laneB">
          <mxGeometry x="300" y="65" width="220" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="目标方向的听觉平滑幅度参考&#xa;cl,ip / cr,ip&#xa;合并为 cip" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="laneB">
          <mxGeometry x="565" y="75" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="bnote" value="这条路径不直接恢复完整 HRTF；它只生成较平滑、较易空间插值的听觉频带幅度目标。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="laneB">
          <mxGeometry x="305" y="250" width="300" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="corr" value="计算 ERB 频带校正量（dB）&#xa;Craw = cip − cHRIR,ip&#xa;等价于线性幅度域中的目标幅度 / 当前幅度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="965" width="500" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="spline" value="频率轴重建&#xa;将稀疏 ERB 中心频率上的 Craw&#xa;用 cubic spline 插值到完整 0～fs/2 频率轴" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="1110" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="limitDecision" value="limitMC = true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="1245" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="limit" value="限制低频校正范围&#xa;计算空间混叠频率&#xa;fA = Nmax·c / (2π·headRadius)&#xa;低于 fAt 的校正设为 0 dB；fAt～fA 淡入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1235" width="370" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="linear" value="dB 校正量转为线性增益&#xa;C = 10^(CdB/20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="1400" width="410" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="softDecision" value="mc 是否有限？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="1525" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="soft" value="有限：按 mc 和 mcKnee&#xa;对校正增益执行 soft limiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1535" width="330" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="unlimited" value="Demo：mc = Inf&#xa;跳过增益软限制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1535" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="phaseDecision" value="mcMinPhase = true？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="1680" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="minphase" value="设计最小相位校正滤波器&#xa;补全双边谱 → IFFT&#xa;AKphaseManipulation(..., 'min') → FFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1675" width="380" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="zerophase" value="保留零相位幅度校正滤波器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="1690" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="apply" value="应用校正滤波器&#xa;ĤMCA,L = ĤnoMC,L · CL&#xa;ĤMCA,R = ĤnoMC,R · CR&#xa;并保存 corrFilt_lim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="1845" width="460" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ifft" value="生成最终 HRIR&#xa;单边 HRTF → 双边谱 → IFFT&#xa;按 hrirLength 截取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="745" y="2010" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="输出 interpHRTFset&#xa;HRTF_L/R、HRIR_L/R、频率轴、目标网格和 MCA 参数&#xa;同时保留 noMC HRTF 与校正滤波器，供残差网络使用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="2155" width="600" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="params" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="split"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="复数 HRTF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="split" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HRIR / 幅度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="split" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneA" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneA" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneA" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneA" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneB" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="laneB" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="当前听觉幅度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="corr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="目标听觉幅度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="corr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="corr" target="spline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="spline" target="limitDecision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="limitDecision" target="limit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="limitDecision" target="linear"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="limit" target="linear"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="linear" target="softDecision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="softDecision" target="soft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="否：Inf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="softDecision" target="unlimited"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="soft" target="phaseDecision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="unlimited" target="phaseDecision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="phaseDecision" target="minphase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="phaseDecision" target="zerophase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="minphase" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="zerophase" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="未校正 HRTF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="a4" target="apply"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="930"/><mxPoint x="180" y="1900"/></Array></mxGeometry></mxCell>
        <mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="apply" target="ifft"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="ifft" target="output"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
