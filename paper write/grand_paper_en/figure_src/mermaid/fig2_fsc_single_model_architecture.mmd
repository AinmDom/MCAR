  subgraph S4["4  Binaural spectral CNN — Stage D trainable"]
    direction TB
    C1["CNN stem<br/>ReflectionPad1d(3)<br/>Conv1d 7 → 48, kernel 7<br/>GroupNorm(8) + SiLU"]
    C2["Direction encoder<br/>Linear 3 → 64 → 64<br/>SiLU after both layers<br/>condition width 64"]
    B1["Block 1<br/>dilation 1, kernel 7"]
    B2["Block 2<br/>dilation 2, kernel 7"]
    B3["Block 3<br/>dilation 4, kernel 7"]
    B4["Block 4<br/>dilation 8, kernel 7"]
    C5["Each block<br/>depthwise Conv1d + FiLM<br/>pointwise 48 → 96 → 48"]
    C3["Conv1d 48 → 2<br/>kernel 1"]
    C4["CNN increment C_theta(X, q)<br/>[B, N, 2]"]
    C1 --> B1 --> B2 --> B3 --> B4 --> C3 --> C4
    C5 -. block design .-> B1
    C5 -. block design .-> B2
    C5 -. block design .-> B3
    C5 -. block design .-> B4
  end

  subgraph S5["5  Residual output"]
    direction TB
    O1["Base residual r_F<br/>[B, N, 2]"]
    O2["CNN increment C_theta<br/>[B, N, 2]"]
