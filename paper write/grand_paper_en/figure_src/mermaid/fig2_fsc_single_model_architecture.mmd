  end

  subgraph S3["3  Seven-channel feature builder"]
    direction TB
    Z1["1  L MCA"]
    Z2["2  L correction"]
    Z3["3  L base residual"]
    Z4["4  R MCA"]
    Z5["5  R correction"]
